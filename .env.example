# Security / Auth Configurations
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN=700000
REFRESH_TOKEN_EXPIRES_IN=700000

# Database Configurations
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_TYPE=postgresql
DB_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Project Configurations
BASE_DIR=.

# Cloudinary Configurations
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configurations
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configurations (Resend)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=your_verified_sender_email

# Dashboard Configuration
DASHBOARD=

# AI Configurations (AI-CV-GENERATOR)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
